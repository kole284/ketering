// See docs/BACKEND_PLAN.md (kept locally). Money is whole dinars; quantities are tenths of a unit.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Service {
  ketering
  torte_i_kolaci @map("torte-i-kolaci")
  kuvana_jela    @map("kuvana-jela")
  pica

  @@map("service")
}

enum Unit {
  kg
  kom
  porcija
  paket

  @@map("unit")
}

/// The id is the URL slug, e.g. "bistro-dorcol".
model Restaurant {
  id            String              @id
  name          String
  /// Part of town, shown on the site.
  area          String
  /// Pickup address; sent to the customer only after payment, never to the frontend.
  pickupAddress String              @map("pickup_address")
  city          String
  /// Where this restaurant's orders go.
  orderEmail    String              @map("order_email")
  phone         String
  /// Minimum hours between ordering and the delivery slot.
  leadTimeHours Int                 @map("lead_time_hours")
  isActive      Boolean             @default(true) @map("is_active")
  imageUrl      String?             @map("image_url")
  /// Kept in step with reviews; null until the first one.
  ratingAvg     Float?              @map("rating_avg")
  ratingCount   Int                 @default(0) @map("rating_count")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  services      RestaurantService[]
  menuItems     MenuItem[]
  bills         Bill[]

  @@map("restaurants")
}

/// What a restaurant offers. Drinks are not listed: every restaurant sells Servingo's.
model RestaurantService {
  restaurantId String     @map("restaurant_id")
  service      Service
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@id([restaurantId, service])
  @@map("restaurant_services")
}

/// A dish, or a Servingo drink when restaurantId is null (the migration enforces this with service = 'pica').
model MenuItem {
  id           String      @id @default(cuid())
  restaurantId String?     @map("restaurant_id")
  service      Service
  name         String
  description  String
  priceRsd     Int         @map("price_rsd")
  unit         Unit
  /// Shown next to the price, e.g. "paket od 8 × 0,33 l".
  unitNote     String?     @map("unit_note")
  /// Quantities are tenths of a unit: 5 = 0,5 kg.
  minQtyTenths Int         @default(10) @map("min_qty_tenths")
  stepTenths   Int         @default(10) @map("step_tenths")
  isPopular    Boolean     @default(false) @map("is_popular")
  isActive     Boolean     @default(true) @map("is_active")
  sortOrder    Int         @default(0) @map("sort_order")
  imageUrl     String?     @map("image_url")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  billItems    BillItem[]

  @@index([restaurantId, sortOrder])
  @@map("menu_items")
}

/// Places with delivery; anywhere else is pickup only.
model DeliveryCity {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  @@map("delivery_cities")
}

/// A single row (id = 1). Bills copy these amounts, so changes never touch past orders.
model Settings {
  id                    Int      @id @default(1)
  deliveryFeeRsd        Int      @map("delivery_fee_rsd")
  platformFeeRsd        Int      @map("platform_fee_rsd")
  deliveryMinimumRsd    Int      @map("delivery_minimum_rsd")
  /// Gets a copy of every bill with drinks, since Servingo supplies them.
  servingoOrdersEmail   String   @default("porudzbine@servingo.rs") @map("servingo_orders_email")
  /// How long an order waits for payment before it counts as cancelled.
  pendingPaymentMinutes Int      @default(30) @map("pending_payment_minutes")
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("settings")
}

enum Method {
  dostava
  preuzimanje

  @@map("method")
}

enum BuyerType {
  fizicko
  pravno

  @@map("buyer_type")
}

enum OrderStatus {
  pending_payment
  paid
  payment_failed
  cancelled
  refunded

  @@map("order_status")
}

enum Fulfilment {
  delivery
  pickup

  @@map("fulfilment")
}

enum PickupReason {
  chosen
  city
  minimum

  @@map("pickup_reason")
}

enum BillStatus {
  new
  confirmed
  ready
  delivered
  picked_up
  cancelled

  @@map("bill_status")
}

enum PaymentStatus {
  succeeded
  failed

  @@map("payment_status")
}

enum Recipient {
  customer
  restaurant
  servingo

  @@map("recipient")
}

enum NotificationStatus {
  sent
  failed
  /// No mail provider configured; the email was only written to the log.
  logged

  @@map("notification_status")
}

/// One card payment by the customer, covering one bill per restaurant.
model Order {
  id             String         @id @default(cuid())
  /// Shown to the customer, e.g. "SRV-7K3Q9".
  publicCode     String         @unique @map("public_code")
  /// Lets the customer see the order status without an account.
  accessToken    String         @map("access_token")
  /// Language of the customer's emails.
  locale         String
  deliveryDate   DateTime       @map("delivery_date") @db.Date
  slotHour       Int            @map("slot_hour")
  method         Method
  /// Set only when at least one bill is delivered.
  city           String?
  address        String?
  customerName   String         @map("customer_name")
  email          String
  phone          String
  buyerType      BuyerType      @map("buyer_type")
  companyName    String?        @map("company_name")
  pib            String?
  mb             String?
  totalRsd       Int            @map("total_rsd")
  status         OrderStatus    @default(pending_payment)
  idempotencyKey String         @unique @map("idempotency_key")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  /// After this a pending order counts as cancelled, even before the cleanup job runs.
  expiresAt      DateTime       @map("expires_at") @db.Timestamptz(6)
  paidAt         DateTime?      @map("paid_at") @db.Timestamptz(6)
  bills          Bill[]
  payments       Payment[]
  notifications  Notification[]

  @@index([status, expiresAt])
  @@map("orders")
}

/// One restaurant's bill within an order; restaurantId is null for Servingo's own drinks bill.
model Bill {
  id             String         @id @default(cuid())
  orderId        String         @map("order_id")
  restaurantId   String?        @map("restaurant_id")
  /// Copied so the bill reads the same if the restaurant is renamed.
  sellerName     String         @map("seller_name")
  fulfilment     Fulfilment
  pickupReason   PickupReason?  @map("pickup_reason")
  subtotalRsd    Int            @map("subtotal_rsd")
  deliveryFeeRsd Int            @map("delivery_fee_rsd")
  platformFeeRsd Int            @map("platform_fee_rsd")
  totalRsd       Int            @map("total_rsd")
  hasDrinks      Boolean        @map("has_drinks")
  status         BillStatus     @default(new)
  /// Filled once invoicing is decided (open question 2 in the plan).
  invoiceNumber  String?        @map("invoice_number")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  restaurant     Restaurant?    @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  items          BillItem[]
  notifications  Notification[]

  @@index([orderId])
  @@index([restaurantId, status])
  @@map("bills")
}

/// A line as it was bought: name and price are copied from the menu.
model BillItem {
  id             String    @id @default(cuid())
  billId         String    @map("bill_id")
  menuItemId     String?   @map("menu_item_id")
  name           String
  unit           Unit
  unitNote       String?   @map("unit_note")
  unitPriceRsd   Int       @map("unit_price_rsd")
  quantityTenths Int       @map("quantity_tenths")
  lineTotalRsd   Int       @map("line_total_rsd")
  isDrink        Boolean   @map("is_drink")
  sortOrder      Int       @default(0) @map("sort_order")
  bill           Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
  menuItem       MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([billId])
  @@map("bill_items")
}

/// Every payment result the provider reported; the unique key makes a repeated callback a no-op.
model Payment {
  id          String        @id @default(cuid())
  orderId     String        @map("order_id")
  provider    String
  providerRef String        @map("provider_ref")
  amountRsd   Int           @map("amount_rsd")
  status      PaymentStatus
  rawPayload  Json?         @map("raw_payload")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([provider, providerRef])
  @@index([orderId])
  @@map("payments")
}

/// Log of every email sent (or attempted) about an order.
model Notification {
  id        String             @id @default(cuid())
  orderId   String             @map("order_id")
  billId    String?            @map("bill_id")
  recipient Recipient
  toEmail   String             @map("to_email")
  template  String
  status    NotificationStatus
  error     String?
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  order     Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bill      Bill?              @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("notifications")
}
